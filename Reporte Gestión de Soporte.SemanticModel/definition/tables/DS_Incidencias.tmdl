table DS_Incidencias
	lineageTag: 67e8be11-565c-4cb2-9832-2e014eec1707

	measure UltAct = "Última actualización: "
		lineageTag: dbafc67d-9121-4826-9f39-cbb564434664

	measure MsjBienvenida = "¡Bienvenid@, " & LEFT(USERPRINCIPALNAME(), FIND("@", USERPRINCIPALNAME()) - 1) & "!"
		lineageTag: e2a440b4-9e2b-4761-8c7e-96d3a07ef714

	measure IncCerradas =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(DS_Incidencias[ID]),
			        (
			            DS_Incidencias[State] = "Closed"
			            || DS_Incidencias[State] = "Resolved"
			        )
			        && CONTAINSSTRING(DS_Incidencias[Tags], "INCIDENCIA")
			    ),
			0)
		formatString: 0
		lineageTag: 43d9ed90-5cec-4145-8065-54a47dce6ed4

	measure IncEnProceso =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(DS_Incidencias[ID]),
			        DS_Incidencias[State] = "Active" && CONTAINSSTRING(DS_Incidencias[Tags], "INCIDENCIA")
			    ),
			    0
			)
		formatString: 0
		lineageTag: f5c9ca6c-4363-4aff-a72b-3d4af3a728ac

	measure IncAbiertas =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(DS_Incidencias[ID]),
			        DS_Incidencias[State] = "New" && CONTAINSSTRING(DS_Incidencias[Tags], "INCIDENCIA")
			    ),
			    0
			)
		formatString: 0
		lineageTag: deb3d467-bc2f-4a38-8036-eed4b22e5498

	measure IncTotales = DS_Incidencias[IncAbiertas]+DS_Incidencias[IncCerradas]+DS_Incidencias[IncEnProceso]+DS_Incidencias[IncBloqueadas]
		formatString: 0
		lineageTag: 05e76d09-9e77-44f3-9336-0d2a195c48ad

	measure IncBloqueadas =
			
			COALESCE(
			    CALCULATE(
			        DISTINCTCOUNT(DS_Incidencias[ID]),
			        DS_Incidencias[State] = "Blocked" && CONTAINSSTRING(DS_Incidencias[Tags], "INCIDENCIA")
			    ),
			    0
			)
		formatString: 0
		lineageTag: 671a4814-ac99-416d-870a-610a08efb94a

	measure DuracionINC_Promedio = ```
			
			var avg_inc =AVERAGE(DS_Incidencias[DuracionINC])
			RETURN 
			    if( avg_inc = BLANK(),0,ROUND(avg_inc,0) )
			```
		formatString: 0
		lineageTag: 219da410-4744-4abf-aa7a-b6c5718ccdf0

	measure Inactividad = ```
			
			SUMX(
			    DS_Incidencias, 
			    IF(
			        DS_Incidencias[DuracionINC] > 0 && DS_Incidencias[Disponible_SI_NO] = "NO", 
			        DS_Incidencias[DuracionINC], 
			        0
			    )
			)
			
			```
		formatString: 0
		lineageTag: d7b80339-84d2-4bd7-8268-dbdcab11e054

	measure Disponible = ```
			
			SUMX(
			    DS_Incidencias, 
			    DS_Incidencias[TiempoTotal] - DS_Incidencias[DuracionINC]
			)
			
			```
		formatString: 0
		lineageTag: 45746de6-786f-4a14-ac27-b8d2c21a59a3

	measure 'Baja disponibilidad' = ```
			
			SUMX(
			    DS_Incidencias, 
			    IF(
			        DS_Incidencias[DuracionINC] > 0 && DS_Incidencias[Disponible_SI_NO] = "SI", 
			        DS_Incidencias[DuracionINC], 
			        0
			    )
			)
			
			```
		formatString: 0
		lineageTag: 1bb1d7a8-7317-49d7-af03-a8d0833c4078

	measure CantProductos =
			CALCULATE(
			    DISTINCTCOUNT(DS_Incidencias[Producto]),
			    NOT(ISBLANK(DS_Incidencias[Producto]))
			)
		formatString: 0
		lineageTag: 1a9238e8-1270-4029-8b6e-70afd2744b3f

	measure Medida = ". "
		lineageTag: 8bfc9900-4b9d-4b09-8c97-93342bff49e2

	column YYYYMM = ```
			FORMAT(DS_Incidencias[Fecha Inicio], "YYYYMM")
			
			```
		lineageTag: de9f3a5d-0176-44fc-b2e6-88b1dd0d2b0a
		summarizeBy: none

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Mes-anio = ```
			
			VAR anio = DS_Incidencias[Fecha Inicio].[Año]
			VAR mes = RIGHT(DS_Incidencias[YYYYMM],2)
			 VAR mesTexto = 
			    SWITCH(
			        mes,
			        "01", "Ene",
			        "02", "Feb",
			        "03", "Mar",
			        "04", "Abr",
			        "05", "May",
			        "06", "Jun",
			        "07", "Jul",
			        "08", "Ago",
			        "09", "Sep",
			        "10", "Oct",
			        "11", "Nov",
			        "12", "Dic",
			        BLANK() -- Devuelve vacío si el mes no es válido
			    )
			RETURN 
			    IF(ISBLANK(mesTexto), BLANK(), mesTexto & "-" & anio)
			```
		lineageTag: ecf204de-f093-405e-8e17-7012221be439
		summarizeBy: none
		sortByColumn: YYYYMM

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column DuracionINC = COALESCE(DATEDIFF(DS_Incidencias[Fecha Inicio],DS_Incidencias[Fecha Fin],HOUR),0)
		formatString: 0
		lineageTag: fc26a0dc-5f48-41df-8b7b-9892c6b5f7ae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column FechaTomaDeControl =
			
			SWITCH(
			    TRUE(),
			    DS_Incidencias[Faena] = "ANT" && DS_Incidencias[Producto] = "Mineral Tracker ANT", DATE(2024, 2, 15),
			    DS_Incidencias[Faena] = "ANT" && DS_Incidencias[Producto] = "Mineral Tracker 2.0", DATE(2026, 1, 12),
			    DS_Incidencias[Faena] = "ANT" && DS_Incidencias[Producto] = "SIRO Ácido", DATE(2026, 1, 12),
			    DS_Incidencias[Faena] = "ANT" && DS_Incidencias[Producto] = "SIRO Apilamiento", DATE(2024, 1, 12),
			    DS_Incidencias[faena] = "CEN" && DS_Incidencias[producto] = "MT CEN", DATE(2023, 10, 15),
			    DS_Incidencias[faena] = "CEN" && DS_Incidencias[producto] = "duhovit", DATE(2024, 11, 1),
			    DS_Incidencias[faena] = "MLP" && DS_Incidencias[producto] = "ADA MLP", DATE(2024, 1, 16),
			    DS_Incidencias[faena] = "MLP" && DS_Incidencias[producto] = "PDM CAEX MLP", DATE(2024, 8, 15),
			    DATE(2023, 12, 1)  -- Valor predeterminado si no se cumple ninguna condición
			)
		formatString: General Date
		lineageTag: 1c903a93-9ec7-42c6-a33b-52470bfd1920
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 0c583aa8-fccd-42fd-8832-b03986303fc8
			defaultHierarchy: LocalDateTable_32bf6e33-81f7-4387-a7fa-10a7e5f067c4.'Jerarquía de fechas'

		annotation SummarizationSetBy = Automatic

	column TiempoTotal = ```
			
			DATEDIFF(DS_Incidencias[FechaTomaDeControl], NOW(), HOUR)
			
			```
		formatString: 0
		lineageTag: 4590ce14-9f94-4ee1-b44c-b4b8d795ae73
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Area_Resolutora_Front = ```
			
			LOOKUPVALUE(
			    De_Para[Nombre],
			    De_Para[Nombre completo], DS_Incidencias[Area Resolutora]
			)
			
			```
		lineageTag: 9405dbc5-3acb-445c-a813-5310c11bad9f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

