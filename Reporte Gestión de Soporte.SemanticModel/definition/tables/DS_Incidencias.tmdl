	column TituloINC =
			
			VAR PosicionInicio = SEARCH("INC:", DS_Incidencias[Title], 1, LEN(DS_Incidencias[Title])) + 4
			RETURN
			TRIM(MID(DS_Incidencias[Title], PosicionInicio, LEN(DS_Incidencias[Title])))
		lineageTag: d930aa4e-75ff-4d02-a4b0-774626a81643
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column EstadoHU = IF(DS_Incidencias[State]="New","Backlog",IF(DS_Incidencias[State]="Blocked","Bloqueadas",IF(DS_Incidencias[State]="Closed","Cerradas",IF(DS_Incidencias[State]="Resolved","Cerradas",IF(DS_Incidencias[State]="Active","En Proceso")))))
		lineageTag: e22c4aec-aaf2-4659-b546-39f60f0c22b1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Criticidad
		dataType: string
		lineageTag: 28d04a61-8c92-4876-8fe0-707f83bcd265
		summarizeBy: none
		sourceColumn: Criticidad

		annotation SummarizationSetBy = Automatic

	column SemanaDelMes_FechaInicio = ```
			
			VAR PrimerDiaMes = EOMONTH(DS_Incidencias[Fecha Inicio], -1) + 1
			VAR NumeroSemanaMes = WEEKNUM(DS_Incidencias[Fecha Inicio], 2) - WEEKNUM(PrimerDiaMes, 2) + 1
			RETURN NumeroSemanaMes
			
			```
		formatString: 0
		lineageTag: 338a34f8-37ce-4456-8368-01352a028f37
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

