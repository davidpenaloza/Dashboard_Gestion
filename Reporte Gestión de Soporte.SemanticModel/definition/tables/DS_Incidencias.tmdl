	column DescripcionBreve = IF(DS_Incidencias[Descripción Breve]="N/A" || ISBLANK(DS_Incidencias[Descripción Breve]),DS_Incidencias[TituloINC],DS_Incidencias[Descripción Breve])
		lineageTag: 264940c3-e832-4f5f-97c4-5440e84c5116
